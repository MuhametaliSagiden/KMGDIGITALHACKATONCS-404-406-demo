@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Ошибка</h1>
<h2 class="text-danger">При обработке запроса произошла ошибка.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Идентификатор запроса:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим разработки</h3>
<p>
    В режиме <strong>Development</strong> отображаются подробные сведения об ошибке.
</p>
<p>
    <strong>Не включайте режим Development в опубликованном приложении.</strong>
    Он может показать пользователям конфиденциальные сведения из исключений.
    Для локальной отладки задайте переменной среды <strong>ASPNETCORE_ENVIRONMENT</strong> значение <strong>Development</strong>
    и перезапустите приложение.
</p>
