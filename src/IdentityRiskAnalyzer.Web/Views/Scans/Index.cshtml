@model IdentityRiskAnalyzer.Web.ViewModels.ScanListViewModel
@{
    ViewData["Title"] = "История сканирований";
}

<h1>Сканирования Active Directory</h1>
<p class="text-muted">Каждое завершённое сканирование сохраняется как отдельный снимок в SQLite. Запуск выполняется в рамках запроса и может занять несколько минут.</p>
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning" role="alert">@UiText.Message(Model.Message)</div>
}
<form asp-controller="Scans" asp-action="Start" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Начать сканирование</button>
</form>
<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead><tr><th>ID</th><th>Начало (UTC)</th><th>Завершение (UTC)</th><th>Статус</th><th>Сервер</th><th>Объекты</th><th>Находки</th><th>Ошибки</th><th>Оценка безопасности AD</th><th>Длительность</th></tr></thead>
        <tbody>
        @foreach (var scan in Model.Scans)
        {
            <tr>
                <td><a asp-controller="Scans" asp-action="Details" asp-route-id="@scan.Id">@scan.Id</a></td>
                <td>@scan.StartedAtUtc.ToString("u")</td>
                <td>@(scan.FinishedAtUtc?.ToString("u") ?? "—")</td>
                <td>@UiText.ScanStatus(scan.Status)</td><td>@scan.Server</td><td>@scan.ObjectsScanned</td>
                <td>@scan.FindingsCount</td><td>@scan.ErrorsCount</td>
                <td>@(scan.AdSecurityScore?.ToString() ?? "—")</td>
                <td>@(scan.Duration?.ToString(@"hh\:mm\:ss") ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
