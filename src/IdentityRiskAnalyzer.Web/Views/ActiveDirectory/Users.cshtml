@model IdentityRiskAnalyzer.Web.ViewModels.AdUserListViewModel
@{
    ViewData["Title"] = "Пользователи Active Directory";
}

<h1>Пользователи Active Directory</h1>
<p class="text-muted">Данные каталога загружаются из Active Directory и хранятся в памяти только на время этого запроса.</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@UiText.Message(Model.ErrorMessage)</div>
}
else if (Model.TotalCount == 0)
{
    <div class="alert alert-info" role="status">Каталог не вернул пользователей.</div>
}
else
{
    <p>
        Показано записей: @Model.Users.Count из @Model.TotalCount.
        @if (Model.IsLimited)
        {
            <span>Показаны первые @Model.DisplayLimit результатов.</span>
        }
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Имя SAM</th>
                    <th scope="col">Отображаемое имя</th>
                    <th scope="col">UPN</th>
                    <th scope="col">Последняя активность (UTC)</th>
                    <th scope="col">Пароль изменён (UTC)</th>
                    <th scope="col">Число SPN</th>
                    <th scope="col">Сервисная</th>
                    <th scope="col">Привилегированная</th>
                    <th scope="col">Различающееся имя (DN)</th>
                    <th scope="col">Членство в группах</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.SamAccountName</td>
                        <td>@user.DisplayName</td>
                        <td>@user.UserPrincipalName</td>
                        <td>@(user.LastKnownActivityUtc?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "—")</td>
                        <td>@(user.PasswordLastSetUtc?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "—")</td>
                        <td>@user.SpnCount</td>
                        <td>
                            <span class="badge @user.ServiceAccountClassification.BadgeCssClass">@UiText.ServiceAccountStatus(user.ServiceAccountClassification.Status)</span>
                            @if (user.ServiceAccountClassification.DetectionMethod != "None")
                            {
                                <small class="d-block">@UiText.DetectionMethod(user.ServiceAccountClassification.DetectionMethod)</small>
                            }
                        </td>
                        <td>
                            @if (user.IsPrivileged)
                            {
                                <span class="badge text-bg-warning">Да (@user.PrivilegedGroupCount)</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Нет</span>
                            }
                        </td>
                        <td class="text-break">@user.DistinguishedName</td>
                        <td><a asp-controller="ActiveDirectory" asp-action="UserGroups" asp-route-objectGuid="@user.ObjectGuid">Открыть состав групп</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
