@model IdentityRiskAnalyzer.Web.ViewModels.AdGroupListViewModel
@{
    ViewData["Title"] = "Группы Active Directory";
}

<h1>Группы Active Directory</h1>
<p class="text-muted">Данные загружаются из Active Directory и хранятся в памяти только на время этого запроса. Показаны только непосредственные участники групп.</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@UiText.Message(Model.ErrorMessage)</div>
}
else if (Model.IncompleteMemberLists > 0)
{
    <div class="alert alert-warning" role="status">
        Для @Model.IncompleteMemberLists групп список участников загружен не полностью; число участников может быть неполным.
    </div>
}

@if (Model.ErrorMessage is null && Model.TotalCount == 0)
{
    <div class="alert alert-info" role="status">Каталог не вернул группы.</div>
}
else if (Model.ErrorMessage is null)
{
    <p>
        Показано групп: @Model.Groups.Count из @Model.TotalCount.
        @if (Model.IsLimited)
        {
            <span>Показаны первые @Model.DisplayLimit результатов.</span>
        }
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Группа</th>
                    <th scope="col">Имя SAM</th>
                    <th scope="col">SID</th>
                    <th scope="col">Тип</th>
                    <th scope="col">Непосредственные участники</th>
                    <th scope="col">Управляется</th>
                    <th scope="col">Различающееся имя (DN)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.Groups)
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>@group.SamAccountName</td>
                        <td>@group.Sid</td>
                        <td>@UiText.GroupType(group.GroupTypeDisplay)</td>
                        <td>
                            @group.MembersCount
                            @if (!group.MembersComplete)
                            {
                                <span class="badge text-bg-warning">Частично</span>
                            }
                        </td>
                        <td>@group.ManagedBy</td>
                        <td class="text-break">@group.DistinguishedName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p><a asp-action="Index">Назад к настройкам Active Directory</a></p>
