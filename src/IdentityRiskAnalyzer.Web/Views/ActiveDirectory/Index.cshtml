@model IdentityRiskAnalyzer.Web.ViewModels.ActiveDirectoryConnectionViewModel
@{
    ViewData["Title"] = "Подключение к Active Directory";
}

<h1>Подключение к Active Directory</h1>
<p class="text-muted">Проверьте настроенный LDAP-адрес и доступность сервера.</p>

<dl class="row">
    <dt class="col-sm-3">Сервер</dt>
    <dd class="col-sm-9">@Model.Server</dd>

    <dt class="col-sm-3">Порт</dt>
    <dd class="col-sm-9">@Model.Port</dd>

    <dt class="col-sm-3">Защита подключения</dt>
    <dd class="col-sm-9">@Model.Protocol</dd>

    <dt class="col-sm-3">Базовый DN</dt>
    <dd class="col-sm-9">@Model.BaseDn</dd>

    <dt class="col-sm-3">Тайм-аут</dt>
    <dd class="col-sm-9">@Model.TimeoutSeconds с</dd>

    <dt class="col-sm-3">Учётные данные настроены</dt>
    <dd class="col-sm-9">@(Model.CredentialsConfigured ? "Да" : "Нет — будут использованы текущие данные входа")</dd>
</dl>

@if (Model.Protocol == "LDAP")
{
    <div class="alert alert-info" role="status">LDAP-соединение не защищено LDAPS/TLS. Если доступно, настройте доверенный сертификат контроллера домена и используйте LDAPS на порту 636.</div>
}

<form asp-controller="ActiveDirectory" asp-action="TestConnection" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Проверить подключение</button>
</form>

<p class="mt-3">
    <a asp-controller="ActiveDirectory" asp-action="Users" class="btn btn-outline-secondary">Показать пользователей</a>
    <a asp-controller="ActiveDirectory" asp-action="Groups" class="btn btn-outline-secondary">Показать группы</a>
</p>

@if (Model.TestResult is { } result)
{
    <div class="alert @(result.Success ? "alert-success" : "alert-danger") mt-4" role="alert">
        <h2 class="h5">@(result.Success ? (result.UseSsl ? "Подключение LDAPS установлено" : "Подключение LDAP установлено") : "Не удалось подключиться")</h2>
        <p class="mb-1">@UiText.Message(result.Message)</p>
        @if (result.Success)
        {
            <div>Сервер: @result.Server</div>
            <div>Порт: @result.Port</div>
            <div>Протокол: @(result.UseSsl ? "LDAPS" : "LDAP")</div>
            <div>TLS: @(result.UseSsl ? "Включён" : "Отключён")</div>
            <div>Время: @result.DurationMs мс</div>
        }
    </div>
}
