@model IdentityRiskAnalyzer.Web.ViewModels.UserGroupMembershipViewModel
@{
    ViewData["Title"] = "Членство пользователя в группах";
}

<h1>Членство в группах: @Model.UserName</h1>
@if (!string.IsNullOrWhiteSpace(Model.DistinguishedName))
{
    <p class="text-muted text-break">@Model.DistinguishedName</p>
}

@if (Model.ErrorMessage is null)
{
    <section class="card mb-4" aria-labelledby="service-account-classification-heading">
        <div class="card-body">
            <h2 id="service-account-classification-heading" class="h4">Классификация сервисной учётной записи</h2>
            <p>
                Сервисная учётная запись:
                <span class="badge @Model.ServiceAccountClassification.BadgeCssClass">@UiText.ServiceAccountStatus(Model.ServiceAccountClassification.Status)</span>
            </p>
            <p><strong>Признак:</strong> @UiText.DetectionMethod(Model.ServiceAccountClassification.DetectionMethod)</p>
            <p><strong>Уверенность:</strong> @UiText.Confidence(Model.ServiceAccountClassification.Confidence)</p>
            <h3 class="h6">Основания</h3>
            @if (Model.ServiceAccountClassification.Evidence.Count == 0)
            {
                <p class="text-muted">Признаки сервисной учётной записи не обнаружены.</p>
            }
            else
            {
                <ul>
                    @foreach (var evidence in Model.ServiceAccountClassification.Evidence)
                    {
                        <li>@UiText.Evidence(evidence)</li>
                    }
                </ul>
            }
            @if (Model.ServiceAccountClassification.ServicePrincipalNames.Count > 0)
            {
                <h3 class="h6">Имена субъектов-служб (SPN)</h3>
                <ul>
                    @foreach (var servicePrincipalName in Model.ServiceAccountClassification.ServicePrincipalNames)
                    {
                        <li class="text-break">@servicePrincipalName</li>
                    }
                </ul>
            }
            <p class="text-muted mb-0"><strong>Политика интерактивного входа:</strong> @UiText.Message(Model.ServiceAccountClassification.InteractiveLogonPolicyStatus)</p>
        </div>
    </section>

    <p>
        Привилегированная:
        @if (Model.IsPrivileged)
        {
            <span class="badge text-bg-warning">Да</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Нет</span>
        }
    </p>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@UiText.Message(Model.ErrorMessage)</div>
}
else if (Model.Memberships.Count == 0)
{
    <div class="alert alert-info" role="status">Прямое или вложенное членство в группах не обнаружено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Целевая группа</th>
                    <th scope="col">Тип членства</th>
                    <th scope="col">Глубина</th>
                    <th scope="col">Цепочка</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var membership in Model.Memberships)
                {
                    <tr>
                        <td>@membership.TargetGroupName</td>
                        <td>@(membership.IsDirect ? "Прямое" : "Вложенное")</td>
                        <td>@membership.Depth</td>
                        <td class="text-break">@membership.Path</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.ErrorMessage is null)
{
    <section class="mt-4" aria-labelledby="privileged-memberships-heading">
        <h2 id="privileged-memberships-heading">Привилегированное членство</h2>
        @if (Model.PrivilegedMemberships.Count == 0)
        {
            <p class="text-muted">Цепочки членства в привилегированных группах не обнаружены.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Целевая привилегированная группа</th>
                            <th scope="col">Тип членства</th>
                            <th scope="col">Глубина</th>
                            <th scope="col">Способ определения</th>
                            <th scope="col">Полная цепочка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model.PrivilegedMemberships)
                        {
                            <tr>
                                <td>
                                    @membership.GroupName
                                    @if (!string.IsNullOrWhiteSpace(membership.GroupSid))
                                    {
                                        <small class="d-block text-muted">@membership.GroupSid</small>
                                    }
                                </td>
                                <td>@(membership.IsDirect ? "Прямое" : "Вложенное")</td>
                                <td>@membership.Depth</td>
                                <td>@UiText.Translate(membership.MatchMethod.ToString())</td>
                                <td class="text-break">@membership.Path</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (Model.ErrorMessage is null)
{
    <section class="mt-4" aria-labelledby="kerberos-delegation-heading">
        <h2 id="kerberos-delegation-heading">Делегирование Kerberos</h2>
        @if (Model.Delegations.Count == 0)
        {
            <p class="text-muted">Делегирование Kerberos не обнаружено.</p>
        }
        else
        {
            @foreach (var delegation in Model.Delegations)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="h5">@UiText.Translate(delegation.Type)</h3>
                        @if (delegation.Targets.Count == 0)
                        {
                            <p><strong>Целевые службы:</strong> Не применимо</p>
                        }
                        else
                        {
                            <p class="mb-1"><strong>Целевые службы:</strong></p>
                            <ul>
                                @foreach (var target in delegation.Targets)
                                {
                                    <li class="text-break">@target</li>
                                }
                            </ul>
                        }
                        <p><strong>Сведения:</strong></p>
                        <pre class="text-break mb-2">@UiText.Evidence(delegation.Evidence)</pre>
                        @if (delegation.RequiresDetailedReview)
                        {
                            <div class="alert alert-warning mb-0" role="status">
                                Требуется дополнительная проверка. ACL дескриптора безопасности RBCD в этой версии не анализируются.
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </section>
}

@if (Model.ErrorMessage is null)
{
    <section class="mt-4" aria-labelledby="detected-risks-heading">
        <h2 id="detected-risks-heading">Обнаруженные риски</h2>
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <div>
                    <span class="text-muted">Оценка риска</span>
                    <strong class="fs-4 ms-2">@Model.RiskScore.Score/100</strong>
                </div>
                <div>
                    <span class="text-muted">Уровень риска</span>
                    <span class="badge @Model.RiskScore.RiskLevelCssClass ms-2">@UiText.Severity(Model.RiskScore.RiskLevel)</span>
                </div>
                <div><span class="text-muted">Находок:</span> @Model.RiskScore.FindingsCount</div>
            </div>
        </div>
        @if (Model.RiskScore.RawScore > 100)
        {
            <p class="text-muted">Накоплено баллов: @Model.RiskScore.RawScore. Итоговая оценка ограничена значением 100.</p>
        }
        @if (Model.RiskFindings.Count == 0)
        {
            <p class="text-muted">По реализованным правилам риски не обнаружены.</p>
        }
        else
        {
            @foreach (var finding in Model.RiskFindings)
            {
                <article class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <h3 class="h5">@UiText.FindingTitle(finding.RuleId, finding.Title)</h3>
                            <span class="badge @finding.SeverityCssClass">@UiText.Severity(finding.Severity)</span>
                        </div>
                        <p class="text-muted"><strong>@finding.RuleId</strong> · @finding.RiskPoints баллов</p>
                        <p>@UiText.FindingDescription(finding.RuleId, finding.Description)</p>
                        <h4 class="h6">Доказательства</h4>
                        <pre class="text-break">@UiText.Evidence(finding.Evidence)</pre>
                        <p class="mb-0"><strong>Рекомендация:</strong> @UiText.FindingRecommendation(finding.RuleId, finding.Recommendation)</p>
                    </div>
                </article>
            }
        }
    </section>
}

<p><a asp-action="Users">Назад к списку пользователей</a></p>
