@using IdentityRiskAnalyzer.Web.Domain.Enums
@model IdentityRiskAnalyzer.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Обзор";
    string SeverityClass(RiskSeverity severity) => severity switch
    {
        RiskSeverity.Critical => "text-bg-danger",
        RiskSeverity.High => "text-bg-warning",
        RiskSeverity.Medium => "text-bg-info",
        _ => "text-bg-secondary"
    };
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">Обзор рисков идентификации</h1>
        @if (Model.HasData)
        {
            <p class="text-muted mb-0">По результатам <a asp-controller="Scans" asp-action="Details" asp-route-id="@Model.ScanRunId">сканирования №@Model.ScanRunId</a> · @Model.ScanStartedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
        }
        else
        {
            <p class="text-muted mb-0">Просмотр сохранённых результатов проверки Active Directory.</p>
        }
    </div>
    @if (Model.ScanRunning)
    {
        <span class="badge text-bg-info fs-6">Сканирование Active Directory выполняется</span>
    }
    else
    {
        <form asp-controller="Scans" asp-action="Start" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">@(Model.HasData ? "Запустить новое сканирование" : "Начать сканирование")</button>
        </form>
    }
</div>

@if (Model.LatestFailedScan is { } failure)
{
    <div class="alert alert-danger" role="alert">
        <strong>Последняя попытка сканирования завершилась ошибкой</strong> · @failure.StartedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'").
        @if (!string.IsNullOrWhiteSpace(failure.ErrorMessage))
        {
            <span>@UiText.Message(failure.ErrorMessage)</span>
        }
        <a class="alert-link" asp-controller="Scans" asp-action="Details" asp-route-id="@failure.ScanRunId">Открыть сканирование №@failure.ScanRunId</a>
    </div>
}

@if (!Model.HasData)
{
    <div class="card shadow-sm dashboard-empty">
        <div class="card-body text-center py-5">
            <h2 class="h4">Завершённых сканирований Active Directory пока нет</h2>
            <p class="text-muted mb-0">Запустите сканирование Active Directory, чтобы заполнить обзор. Неудачные запуски не создают снимок безопасности.</p>
        </div>
    </div>
}
else
{
    @if (Model.ScanStatus == ScanStatus.CompletedWithErrors)
    {
        <div class="alert alert-warning" role="alert">
            Сканирование завершено; число ошибок, которые удалось восстановить: @Model.ErrorsCount.
            <a class="alert-link" asp-controller="Scans" asp-action="Details" asp-route-id="@Model.ScanRunId">Подробнее о сканировании</a>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-outline-primary btn-sm" asp-controller="ScanExports" asp-action="Accounts" asp-route-scanId="@Model.ScanRunId">Экспорт учётных записей (CSV)</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="ScanExports" asp-action="Findings" asp-route-scanId="@Model.ScanRunId">Экспорт находок (CSV)</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100 dashboard-score-card">
                <div class="card-body">
                    <h2 class="h5 text-uppercase text-muted">Оценка безопасности AD</h2>
                    @if (Model.AdSecurityScore.HasValue)
                    {
                        <div class="dashboard-score-value">@Model.AdSecurityScore <span>/ 100</span></div>
                        <div class="progress mt-3" role="progressbar" aria-label="Оценка безопасности AD" aria-valuenow="@Model.AdSecurityScore" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-primary" style="width: @(Math.Clamp(Model.AdSecurityScore.Value, 0, 100))%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-score-value">Нет данных</div>
                    }
                    <p class="small text-muted mt-3 mb-0">100 — в среднем низкий выявленный риск, 0 — высокий. Индивидуальная оценка риска учётной записи работает в обратном направлении.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Последнее завершённое сканирование</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Начало</dt><dd class="col-sm-7">@Model.ScanStartedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                        <dt class="col-sm-5">Завершение</dt><dd class="col-sm-7">@(Model.ScanFinishedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</dd>
                        <dt class="col-sm-5">Длительность</dt><dd class="col-sm-7">@(Model.ScanDuration?.ToString(@"hh\:mm\:ss") ?? "—")</dd>
                        <dt class="col-sm-5">Статус</dt><dd class="col-sm-7">@UiText.ScanStatus(Model.ScanStatus)</dd>
                        <dt class="col-sm-5">Сервер</dt><dd class="col-sm-7">@Model.Server</dd>
                        <dt class="col-sm-5">Базовый DN</dt><dd class="col-sm-7">@Model.BaseDn</dd>
                        <dt class="col-sm-5">Проверено объектов</dt><dd class="col-sm-7">@Model.TotalObjects</dd>
                        <dt class="col-sm-5">Находок / ошибок</dt><dd class="col-sm-7">@Model.TotalFindings / @Model.ErrorsCount</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4">Находки по уровню критичности</h2>
    <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
        <div class="col"><div class="card border-danger h-100"><div class="card-body"><div class="text-muted">Критические</div><div class="dashboard-metric">@Model.CriticalFindings</div></div></div></div>
        <div class="col"><div class="card border-warning h-100"><div class="card-body"><div class="text-muted">Высокие</div><div class="dashboard-metric">@Model.HighFindings</div></div></div></div>
        <div class="col"><div class="card border-info h-100"><div class="card-body"><div class="text-muted">Средние</div><div class="dashboard-metric">@Model.MediumFindings</div></div></div></div>
        <div class="col"><div class="card border-secondary h-100"><div class="card-body"><div class="text-muted">Низкие</div><div class="dashboard-metric">@Model.LowFindings</div></div></div></div>
    </div>

    <h2 class="h4">Сводка по учётным записям</h2>
    <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted">Проверено</div><div class="dashboard-metric">@Model.TotalObjects</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted">Сервисные</div><div class="dashboard-metric">@Model.ServiceAccounts</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted">Привилегированные</div><div class="dashboard-metric">@Model.PrivilegedAccounts</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted">Неактивные</div><div class="dashboard-metric">@Model.StaleAccounts</div></div></div></div>
    </div>

    <section class="card shadow-sm mb-4" aria-labelledby="object-level-heading">
        <div class="card-body">
            <h2 id="object-level-heading" class="h4">Учётные записи по уровню риска</h2>
            <div class="row row-cols-2 row-cols-lg-4 g-3">
                <div class="col"><strong>Критический</strong><div class="dashboard-metric">@Model.CriticalObjects</div></div>
                <div class="col"><strong>Высокий</strong><div class="dashboard-metric">@Model.HighObjects</div></div>
                <div class="col"><strong>Средний</strong><div class="dashboard-metric">@Model.MediumObjects</div></div>
                <div class="col"><strong>Низкий</strong><div class="dashboard-metric">@Model.LowObjects</div></div>
            </div>
        </div>
    </section>

    <section class="card shadow-sm mb-4" aria-labelledby="top-risk-heading">
        <div class="card-body">
            <h2 id="top-risk-heading" class="h4">Учётные записи с наибольшим риском</h2>
            <div class="table-responsive"><table class="table table-striped table-sm align-middle mb-0">
                <thead><tr><th>Учётная запись</th><th>Индивидуальный риск</th><th>Уровень риска</th><th>Находки</th><th>Привилегированная</th><th>Сервисная</th></tr></thead>
                <tbody>
                @foreach (var account in Model.TopRiskyAccounts)
                {
                    <tr>
                        <td><a asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@account.ObjectGuid">@account.AccountName</a></td>
                        <td>@account.RiskScore / 100</td>
                        <td><span class="badge @SeverityClass(account.RiskLevel)">@UiText.Severity(account.RiskLevel)</span></td>
                        <td>@account.FindingsCount</td><td>@(account.IsPrivileged ? "Да" : "Нет")</td><td>@(account.IsServiceAccount ? "Да" : "Нет")</td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <section class="card shadow-sm h-100" aria-labelledby="categories-heading"><div class="card-body">
                <h2 id="categories-heading" class="h4">Категории риска</h2>
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Категория</th><th>Находки</th><th>Затронуто записей</th></tr></thead>
                    <tbody>
                    @foreach (var category in Model.RiskCategories)
                    {
                        <tr><td>@UiText.Category(category.Category)</td><td>@category.FindingsCount</td><td>@category.AffectedAccounts</td></tr>
                    }
                    </tbody>
                </table></div>
            </div></section>
        </div>
        <div class="col-lg-7">
            <section class="card shadow-sm h-100" aria-labelledby="history-heading"><div class="card-body">
                <h2 id="history-heading" class="h4">История оценки безопасности AD</h2>
                <p class="small text-muted">Последние завершённые сканирования: @Model.ScoreHistory.Count · шкала 0–100 · от ранних к поздним</p>
                @if (Model.ScoreHistory.Count < 2)
                {
                    <p class="text-muted">Для отображения динамики нужно больше сканирований.</p>
                }
                <div class="dashboard-chart" role="img" aria-label="История оценки безопасности AD по шкале от 0 до 100">
                    <div class="dashboard-chart-axis"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
                    <div class="dashboard-chart-bars">
                        @foreach (var point in Model.ScoreHistory)
                        {
                            <div class="dashboard-chart-item">
                                <div class="dashboard-chart-track">
                                    @if (point.AdSecurityScore is int value)
                                    {
                                        <div class="dashboard-chart-bar" style="height: @(Math.Clamp(value, 0, 100))%" title="Сканирование №@point.ScanRunId: @value / 100"></div>
                                    }
                                    else
                                    {
                                        <span class="dashboard-chart-no-data">Нет данных</span>
                                    }
                                </div>
                                <span class="dashboard-chart-label">#@point.ScanRunId<br />@point.StartedAtUtc.ToString("MM-dd HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-responsive mt-3"><table class="table table-sm mb-0">
                    <thead><tr><th>Сканирование</th><th>Начало (UTC)</th><th>Оценка безопасности AD</th></tr></thead>
                    <tbody>
                    @foreach (var point in Model.ScoreHistory)
                    {
                        <tr><td><a asp-controller="Scans" asp-action="Details" asp-route-id="@point.ScanRunId">№@point.ScanRunId</a></td><td>@point.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@(point.AdSecurityScore?.ToString() ?? "Нет данных")</td></tr>
                    }
                    </tbody>
                </table></div>
            </div></section>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <section class="card shadow-sm h-100" aria-labelledby="privileged-heading"><div class="card-body">
                <h2 id="privileged-heading" class="h4">Привилегированные учётные записи с высоким риском</h2>
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Учётная запись</th><th>Индивидуальный риск</th><th>Уровень риска</th><th>Находки</th></tr></thead>
                    <tbody>
                    @foreach (var account in Model.HighRiskPrivilegedAccounts)
                    {
                        <tr><td><a asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@account.ObjectGuid">@account.AccountName</a></td><td>@account.RiskScore</td><td><span class="badge @SeverityClass(account.RiskLevel)">@UiText.Severity(account.RiskLevel)</span></td><td>@account.FindingsCount</td></tr>
                    }
                    </tbody>
                </table></div>
            </div></section>
        </div>
        <div class="col-lg-6">
            <section class="card shadow-sm h-100" aria-labelledby="service-heading"><div class="card-body">
                <h2 id="service-heading" class="h4">Сервисные учётные записи с рисками</h2>
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Учётная запись</th><th>Индивидуальный риск</th><th>Уровень риска</th><th>Находки</th></tr></thead>
                    <tbody>
                    @foreach (var account in Model.RiskyServiceAccounts)
                    {
                        <tr><td><a asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@account.ObjectGuid">@account.AccountName</a></td><td>@account.RiskScore</td><td><span class="badge @SeverityClass(account.RiskLevel)">@UiText.Severity(account.RiskLevel)</span></td><td>@account.FindingsCount</td></tr>
                    }
                    </tbody>
                </table></div>
            </div></section>
        </div>
    </div>

    <section class="card shadow-sm mb-4" aria-labelledby="findings-heading"><div class="card-body">
        <h2 id="findings-heading" class="h4">Самые важные находки</h2>
        <div class="table-responsive"><table class="table table-striped table-sm mb-0">
            <thead><tr><th>Критичность</th><th>Учётная запись</th><th>Код правила</th><th>Находка</th><th>Баллы</th></tr></thead>
            <tbody>
            @foreach (var finding in Model.MostImportantFindings)
            {
                <tr><td><span class="badge @SeverityClass(finding.Severity)">@UiText.Severity(finding.Severity)</span></td><td><a asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@finding.ObjectGuid">@finding.ObjectName</a></td><td>@finding.RuleId</td><td>@UiText.FindingTitle(finding.RuleId, finding.Title)</td><td>@finding.RiskPoints</td></tr>
            }
            </tbody>
        </table></div>
    </div></section>
}
